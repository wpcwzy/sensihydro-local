# Vendor data server (leave VENDOR_IP empty to resolve it through public DNS)
VENDOR_HOST=sensihydro.copeland.cn
VENDOR_IP=
VENDOR_PORT=5000

# DTU reconnect port / web + API port
LISTEN_PORT=5000
HTTP_PORT=8090

LOG_LEVEL=INFO

# Split DNS for the DTU only: AdGuard forwards the DTU's queries to
# LAN_IP:DNS_PORT, everything else resolves normally.
LAN_IP=192.168.1.10
DNS_PORT=15353
DNS_UPSTREAM=223.5.5.5,119.29.29.29

# Optional: JSON file describing your indoor units (see examples/)
# UNITS_FILE=/app/bridge/units.json

# Link watchdogs (seconds), 0 disables them
CLOUD_IDLE_TIMEOUT=300
DTU_IDLE_TIMEOUT=180
